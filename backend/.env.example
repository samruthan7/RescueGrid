PORT=5000
JWT_SECRET=rescuegrid-hackathon-secret-key-2026-secure
AUTHORITY_USERNAME=admin
AUTHORITY_PASSWORD=rescuegrid2026!
CLIENT_ORIGIN=http://localhost:5173

# Persistence driver: supabase (default) or json (offline fallback)
STORAGE_DRIVER=supabase
# Set true for offline venue demos: forces JSON storage and deterministic mocked AI.
DEMO_MODE=false
AUTO_ASSIGN_ON_CREATE=false
AVG_TEAM_SPEED_KMPH=40
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=3000
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key
SUPABASE_BUCKET=incident-videos

# AI & Multimodal Video Analysis (upcoming tasks)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hotspot clustering configuration
HOTSPOT_RADIUS_METERS=1000
HOTSPOT_MIN_REPORTS=3
HOTSPOT_WINDOW_MINUTES=60
